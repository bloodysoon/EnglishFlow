{
  "name": "english-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "words:fetch": "node scripts/check-node.cjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/word-sets.ts fetch",
    "words:seed": "node scripts/check-node.cjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/word-sets.ts seed",
    "words:dictionary": "node scripts/check-node.cjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/word-sets.ts dictionary",
    "db:sync": "npm run words:dictionary && supabase db push --remote --include-seed"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
